<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#0B1220" />
  <title>Advertise — JerseyGo</title>
  <meta name="description" content="Advertise on JerseyGo — a quick-links PWA for residents & tourists in Jersey." />

  <link rel="icon" href="../icon.svg" type="image/svg+xml" />
  <link rel="manifest" href="../manifest.webmanifest" />

  <style>
    :root{
      --bg:#070A12; --bg2:#0B1220;
      --line:rgba(255,255,255,.10);
      --text:#E9EEF7; --muted:#A9B4C7;
      --r2:22px; --shadow: 0 22px 50px rgba(0,0,0,.45);
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      color:var(--text);
      background:
        radial-gradient(900px 600px at 12% 12%, rgba(77,163,255,.22), transparent 58%),
        radial-gradient(850px 520px at 88% 10%, rgba(53,208,127,.18), transparent 58%),
        radial-gradient(920px 720px at 50% 95%, rgba(255,176,32,.12), transparent 58%),
        linear-gradient(180deg, var(--bg), var(--bg2));
    }
    a{color:inherit; text-decoration:none}
    .wrap{max-width:980px; margin:0 auto; padding:18px}
    .top{
      display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;
      border:1px solid var(--line); background: rgba(255,255,255,.03);
      border-radius:22px; padding:12px 14px; box-shadow: var(--shadow);
    }
    .brand{display:flex; align-items:center; gap:12px}
    .brand img{width:40px; height:40px; border-radius:14px; box-shadow:0 12px 30px rgba(0,0,0,.35)}
    .brand .name{font-weight:950}
    .brand .sub{font-size:12px; color:var(--muted); margin-top:2px}
    .btn{
      border:1px solid var(--line);
      background: rgba(255,255,255,.05);
      color:var(--text);
      padding:12px 14px;
      border-radius:16px;
      cursor:pointer;
      font-weight:900;
      display:inline-flex; align-items:center; gap:8px;
    }
    .btn:hover{background: rgba(255,255,255,.08)}
    .btn.primary{border-color: rgba(53,208,127,.35); background: rgba(53,208,127,.12)}
    .card{
      margin-top:14px;
      border:1px solid var(--line);
      background: rgba(255,255,255,.03);
      border-radius: var(--r2);
      box-shadow: var(--shadow);
      padding:16px;
    }
    h1{margin:0; font-size:26px}
    p{margin:10px 0 0; color:var(--muted); line-height:1.5}
    .grid{display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:14px}
    @media (max-width:820px){ .grid{grid-template-columns:1fr} }
    .mini{
      margin-top:12px;
      font-size:12px;
      color:rgba(169,180,199,.85);
      line-height:1.5;
    }
    .box{
      border:1px solid var(--line);
      background: rgba(255,255,255,.02);
      border-radius:18px;
      padding:14px;
    }
    .box h3{margin:0; font-size:14px; letter-spacing:.2px}
    .list{margin:10px 0 0; padding:0 0 0 16px; color:var(--muted)}
    .list li{margin:6px 0}
  </style>
</head>

<body>
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <img src="../icon.svg" alt="JerseyGo">
        <div>
          <div class="name">JerseyGo</div>
          <div class="sub">Advertising / featured listing</div>
        </div>
      </div>
      <a class="btn" href="../">← Back to app</a>
    </div>

    <div class="card">
      <h1>Advertise on JerseyGo</h1>
      <p>
        JerseyGo is a fast “one-tap links” app for residents & tourists.
        If you want your business/service featured, message us and we’ll send options.
      </p>

      <div class="grid">
        <div class="box">
          <h3>What you can get</h3>
          <ul class="list">
            <li>Featured placement in a category</li>
            <li>Call / Maps / Website buttons</li>
            <li>Simple “official + useful” style listing</li>
          </ul>
        </div>

        <div class="box">
          <h3>We’ll ask for</h3>
          <ul class="list">
            <li>Business name</li>
            <li>Category</li>
            <li>Website / Google Maps / phone</li>
            <li>Short description</li>
          </ul>
        </div>
      </div>

      <div style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap;">
        <button id="cta" class="btn primary" type="button">💬 Message on WhatsApp</button>
        <button id="suggest" class="btn" type="button">➕ Suggest a useful link</button>
      </div>

      <div class="mini">
        JerseyGo is an unofficial directory. Links should be helpful and public.
      </div>
    </div>
  </div>

  <script>
    const WHATSAPP_NUMBER_INTL = "447700704591";
    const waLink = (text)=> `https://wa.me/${WHATSAPP_NUMBER_INTL}?text=${encodeURIComponent(text)}`;

    document.getElementById("cta").addEventListener("click", ()=>{
      const msg =
        "Hi 👋 I want to advertise on JerseyGo.\n\n" +
        "Business name:\nCategory:\nWebsite / link:\nGoogle Maps link:\nPhone (optional):\nShort description:\n";
      window.open(waLink(msg), "_blank", "noopener");
    });

    document.getElementById("suggest").addEventListener("click", ()=>{
      const msg =
        "Hi 👋 I want to suggest a link for JerseyGo.\n\n" +
        "Title:\nCategory:\nLink (URL):\nWhy it’s useful:\nLanguage (EN/PT/PL/FR):\n";
      window.open(waLink(msg), "_blank", "noopener");
    });
  </script>
</body>
</html>
